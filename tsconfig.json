{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "./lib",
    "checkJs": true
  },
  "include": ["src", "scripts", "test"],
  "exclude": ["build", "lib"]
}
